{
  "categories": [
    "SQL_Injection",
    "WebView",
    "DeepLink",
    "HardCoded",
    "Permission",
    "Insecure_DataStorage",
    "Insecure_Logging"
  ],
  "exclude": [
    ".git/**",
    "**/.git/**",
    "**/original/**",
    "**/node_modules/**",
    "**/.gradle/**",
    "**/R.java",
    "**/R$*.java",
    "**/BuildConfig.java"
  ],
  "include_vendor": false,
  "workers": 4,
  "max_files": 50000,
  "max_file_bytes": 4194304,
  "max_source_bytes": 268435456,
  "max_archive_bytes": 2147483648,
  "max_entry_bytes": 536870912,
  "max_compression_ratio": 250,
  "tool_timeout": 600,
  "jadx": null,
  "apktool": null,
  "decompile": true,
  "suppressions": [],
  "firebase_rules": null,
  "firebase_data": null
}
