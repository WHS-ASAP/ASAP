{
  "rules": {
    ".read": false,
    ".write": false,
    "public": {
      ".read": true,
      "items": {
        ".read": false,
        "$item": {"title": {".validate": "newData.isString()"}}
      }
    },
    "drafts": {
      ".write": true,
      ".validate": "newData.hasChildren(['title'])",
      "title": {".validate": "newData.isString()"}
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {}
      }
    }
  }
}
